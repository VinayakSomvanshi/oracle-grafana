    "keywords": [
      "datasource",
      "oracle",
      "sql"
    ],
    "links": [],
    "logos": {
      "small": "img/logo-64.png",
      "large": "img/logo-512.png"
    },
    "screenshots": [],
    "updated": "2026-10-01",
    "version": "2.3.0"
  },
  "metrics": true,
  "name": "Oracle Data Source",
  "type": "datasource",
  "alerting": true,
  "includes": [
    {
      "type": "dashboard",
