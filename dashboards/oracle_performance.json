      },
      "id": 100,
      "title": "Database Sessions & Health Overview",
      "type": "row",
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Active User Sessions",
      "description": "Currently active user sessions running queries or transactions",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT count(*) AS active_users FROM v$session WHERE status = 'ACTIVE' AND type != 'BACKGROUND'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Inactive Sessions",
      "description": "Connected idle sessions waiting for client commands",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT count(*) AS inactive_sessions FROM v$session WHERE status = 'INACTIVE' AND type != 'BACKGROUND'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 50
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Background Processes",
      "description": "Oracle system background processes (DBWn, LGWR, CKPT, SMON, PMON, etc.)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT count(*) AS bg_processes FROM v$session WHERE type = 'BACKGROUND'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Buffer Cache Hit Ratio",
      "description": "Percentage of page requests satisfied from SGA buffer cache without physical disk I/O",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT ROUND((1 - (phy.value / greatest(cur.value + con.value, 1))) * 100, 2) AS hit_ratio FROM v$sysstat phy, v$sysstat cur, v$sysstat con WHERE phy.name = 'physical reads' AND cur.name = 'db block gets' AND con.name = 'consistent gets'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Library Cache Hit Ratio",
      "description": "Percentage of SQL statements/PLSQL blocks found in shared pool without hard parsing",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT ROUND(SUM(pins - reloads) / greatest(SUM(pins), 1) * 100, 2) AS hit_ratio FROM v$librarycache"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "title": "System Wait Events & Bottlenecks",
      "type": "row",
      "panels": []
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Top 10 System Wait Events (Time Waited Seconds)",
      "description": "Top non-idle wait events highlighting resource contention (I/O, locks, latches)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT event, round(time_waited_micro / 1000000, 2) AS time_waited_sec FROM v$system_event WHERE wait_class != 'Idle' ORDER BY time_waited_micro DESC FETCH FIRST 10 ROWS ONLY"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Wait Class Breakdown",
      "description": "Total wait time aggregated by Oracle wait class category",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT wait_class, total_waits, round(time_waited_micro / 1000000, 2) AS time_waited_sec, round(average_wait / 100, 2) AS avg_wait_ms FROM v$system_wait_class WHERE wait_class != 'Idle' ORDER BY time_waited_micro DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "TIME_WAITED_SEC"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "#EAB839",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "AVG_WAIT_MS"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ]
        },
        "showHeader": true
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 102,
      "title": "Top SQL Statements & Execution Load",
      "type": "row",
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 10 SQL Statements by Elapsed Execution Time",
      "description": "SQL queries consuming the highest cumulative runtime in the library cache",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT sql_id, executions, round(elapsed_time / 1000000, 2) AS elapsed_sec, round(cpu_time / 1000000, 2) AS cpu_sec, buffer_gets, disk_reads, rows_processed, substr(sql_text, 1, 100) AS sql_snippet FROM v$sqlarea WHERE executions > 0 ORDER BY elapsed_time DESC FETCH FIRST 10 ROWS ONLY"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ELAPSED_SEC"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "#EAB839",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 60
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU_SEC"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ]
        },
        "showHeader": true
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 103,
      "title": "Active Long Operations & Redo Log Switches",
      "type": "row",
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Active Long Operations (v$session_longops)",
      "description": "Operations taking more than 6 seconds (scans, index builds, backups)",
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT sid, serial#, opname, target, round(sofar / greatest(totalwork, 1) * 100, 1) AS pct_done, elapsed_seconds AS elapsed_sec, time_remaining AS rem_sec, message FROM v$session_longops WHERE totalwork > 0 AND sofar < totalwork ORDER BY start_time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PCT_DONE"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.displayMode",
                "value": "gradient-gauge"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Redo Log Switches per Hour (Last 24h)",
      "description": "Frequency of log switches (ideal is 2 to 4 per hour)",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 23
      },
      "datasource": {
        "type": "oracle-grafana-datasource",
        "uid": "${DS_ORACLE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "oracle-grafana-datasource",
            "uid": "${DS_ORACLE}"
          },
          "o_sql": "SELECT to_char(first_time, 'YYYY-MM-DD HH24:00') AS time_bucket, count(*) AS log_switches FROM v$log_history WHERE first_time >= sysdate - 1 GROUP BY to_char(first_time, 'YYYY-MM-DD HH24:00') ORDER BY time_bucket"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 6
              },
              {
                "color": "red",
                "value": 12
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
